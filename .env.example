# Copy to .env. Never commit .env.
DAILY_API_KEY=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Optional LLM overrides for agent_assist_bot.llm.create_llm (defaults: anthropic, claude-haiku-5-5)
LLM_PROVIDER=
LLM_MODEL=

# Optional
# Base64 HMAC secret from Daily's pinless_dialin config; when set, the dial-in
# webhook rejects requests without a valid X-Pinless-Signature.
DAILY_DIALIN_HMAC=

# Mock database (ADR 0002). Supabase Session pooler URI: postgresql://postgres.<ref>:<password>@<host>:5432/postgres
# DB tests skip when unset. Secret: .env only. The bot writes its calls row here
# (PRD IN-5, IN-6); without it the bot keeps the call record in memory only.
DATABASE_URL=
# Optional: schema for the bot's DB work (default: the server's search_path). Live
# tests set a throwaway schema so they never touch public.
DATABASE_SCHEMA=
# Optional: intake use case pack id from packs/ (default claims_status).
INTAKE_PACK=
# DAILY_API_URL=https://api.daily.co/v1

# Queue (docs/queue.md). Base URL the bot uses to hand a finished intake to the
# server's queue, e.g. http://127.0.0.1:8000. Unset: handoff is a no-op.
AGENT_ASSIST_SERVER_URL=
# 1 = write queue state through to Postgres (calls, agents). Needs DATABASE_URL.
QUEUE_PERSIST=

# Login (P2-6). Set APP_PASSWORD to require a shared password on every page and API
# (except /healthz and /daily/dialin). Unset: login is off, fine for local dev only.
# SESSION_SECRET signs the 12 hour session cookie and is required when APP_PASSWORD is
# set. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it signs everyone out. Secrets: .env / fly secrets only, never commit.
APP_PASSWORD=
SESSION_SECRET=
# Optional: header your proxy sets to the real client IP, for the login rate limit
# (e.g. Fly-Client-IP on Fly.io). Unset: the socket peer address is used.
TRUSTED_CLIENT_IP_HEADER=
